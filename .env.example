# Copy to .env and fill in. Never commit real values.
PORT=3200
APP_URL=http://localhost:3200

# Google OAuth (create at console.cloud.google.com, OAuth client ID, Web application)
# Authorized redirect URI must be:  APP_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev only: set to 1 to enable a "Continue as test hiker" button on the landing page.
# Leave unset or 0 in production.
ALLOW_DEV_LOGIN=
